APP_NAME=DeepLens API
APP_VERSION=0.2.0-beta
DEBUG=True

# Search (required)
TAVILY_API_KEY=your_tavily_api_key

# Gemini (required)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Groq (optional)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Mistral (optional)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# Ollama (optional, local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# MySQL (see docker/docker-compose.yml for a local dev instance on port 3307,
# kept off 3306 to avoid colliding with any native MySQL install)
DATABASE_URL=mysql+aiomysql://root:password@localhost:3307/deeplens
DB_ECHO=False
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Redis (see docker/docker-compose.yml — port 6380, not the default 6379:
# another project's redis container on this dev machine already owns it)
REDIS_URL=redis://localhost:6380/0
RESEARCH_QUEUE_NAME=research

# ---------------------------------------------------------------------------
# Planned for upcoming phases — not yet read by app/core/config.py::Settings.
# Wiring these up without also adding the corresponding Settings fields will
# silently do nothing; see CLAUDE.md before touching this section.
# ---------------------------------------------------------------------------
# SECRET_KEY=
