# =============================================================================
# Application
# =============================================================================
APP_NAME=DeepLens API
APP_VERSION=0.2.0-beta
# True for local development (this file's default). Production deployments
# should set this to False explicitly.
DEBUG=True

# =============================================================================
# Search
# =============================================================================
# Required
TAVILY_API_KEY=your_tavily_api_key

# =============================================================================
# LLM Providers
# =============================================================================
# Gemini (required)
GEMINI_API_KEY=your_gemini_api_key
# gemini-2.5-flash has been retired (real 404 "no longer available to new
# users", verified live in production) — gemini-3.6-flash is the exact
# replacement Gemini's own error names.
GEMINI_MODEL=gemini-3.6-flash

# Groq (optional — used as first-choice provider with Gemini as fallback)
GROQ_API_KEY=
# llama-3.3-70b-versatile has been retired from Groq's catalog (real calls
# now 404 with "model_not_found", verified live) — openai/gpt-oss-120b is
# the current comparable flagship general-purpose chat model.
GROQ_MODEL=openai/gpt-oss-120b

# Mistral (optional)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# Ollama (optional, local — no key required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# True for local development (this file's default) so the fallback chain is
# Groq -> Mistral -> Ollama -> Gemini. Production has no reachable local
# Ollama server — set this to False there so the chain becomes
# Groq -> Mistral -> Gemini and nothing ever tries to call OLLAMA_BASE_URL.
ENABLE_OLLAMA=True

# Request timeouts — none of these SDKs set one by default, and a stalled
# connection to any provider hangs the whole research pipeline forever
# without one (InferenceEngine only fails over once generate() returns).
# LLM_REQUEST_TIMEOUT_SECONDS is capped in code at 30s regardless of what's
# set here (see Settings._cap_llm_request_timeout in app/core/config.py) —
# part of the 120s total research budget; InferenceEngine tries candidates
# sequentially, so this bounds one generate() call's worst case across the
# whole fallback chain.
LLM_REQUEST_TIMEOUT_SECONDS=20
OLLAMA_REQUEST_TIMEOUT_SECONDS=180

# How long a provider is skipped after a detected quota/rate-limit/
# unavailable failure (a provider's own stated retry delay is used instead
# when its error message includes one).
PROVIDER_QUOTA_COOLDOWN_SECONDS=3600
PROVIDER_RATE_LIMIT_COOLDOWN_SECONDS=60
PROVIDER_UNAVAILABLE_COOLDOWN_SECONDS=300

# =============================================================================
# Vector memory (ChromaDB)
# =============================================================================
# Local development (this file's default): on-disk store, no credentials.
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Production: Chroma Cloud. Leave these empty for local dev — ChromaStore
# uses the local PersistentClient above whenever CHROMA_API_KEY is unset,
# and switches to Chroma Cloud automatically the moment it's set.
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=

# =============================================================================
# Database (MySQL) — see docker/docker-compose.yml for a local dev instance
# on host port 3307 (kept off 3306 to avoid colliding with any native
# MySQL install already running on the default port)
# =============================================================================
DATABASE_URL=mysql+aiomysql://root:password@localhost:3307/deeplens
DB_ECHO=False
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# =============================================================================
# Redis / Task Queue — see docker/docker-compose.yml for a local dev
# instance on host port 6380 (kept off 6379 to avoid colliding with any
# other project's redis container already running on the default port)
# =============================================================================
REDIS_URL=redis://localhost:6380/0
RESEARCH_QUEUE_NAME=research
# 120s is the product-required hard maximum for a single research request —
# enforced by RQ's own SIGALRM-based job timeout. Capped in code at 120
# regardless of what's set here (see Settings._cap_research_job_timeout in
# app/core/config.py), so a stale/misconfigured deployment environment can't
# silently reintroduce unbounded research runtime.
RESEARCH_JOB_TIMEOUT_SECONDS=120
# How many reflection-loop iterations the workflow is allowed before it's
# forced to approve and finish. 1 (single pass) is what reliably fits the
# 120s budget — the reflection agent asks for a second pass on most queries,
# including trivial ones, and one additional pass reliably costs another
# 40-70s. Raise this only alongside a correspondingly larger time budget.
RESEARCH_MAX_ITERATIONS=1

# =============================================================================
# Security
# =============================================================================
# Generate your own with: python -c "import secrets; print(secrets.token_hex(32))"
# Never reuse a checked-in or shared value in any real deployment.
SECRET_KEY=replace_with_a_securely_generated_random_value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# =============================================================================
# Email
# =============================================================================
# Optional: leave SMTP_HOST empty to log reset/verification links instead of
# sending real email (fine for local dev). Fill in with a real SMTP relay
# (e.g. your transactional email provider's SMTP endpoint) to send for real.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@deeplens.local
SMTP_USE_TLS=True
SMTP_TIMEOUT_SECONDS=30

# =============================================================================
# Frontend
# =============================================================================
FRONTEND_URL=http://localhost:3000
# Comma-separated list of browser origins allowed to call this API (CORS).
CORS_ORIGINS=http://localhost:3000
